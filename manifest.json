{
  "manifest_version": 3,
  "name": "One-Click Mark as Spam",
  "version": "2.0.0",
  "description": "Adds a one-click Spam & Delete button to Gmail's toolbar, between Back and Archive.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "spam-and-delete": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Mark as spam and delete the open or selected email"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "One-Click Mark as Spam",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
